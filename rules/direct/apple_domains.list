# NAME: Apple Domains — DIRECT
# UPDATED: 2026-08-24
# PURPOSE: Apple services DIRECT
#
# App Store / iCloud / Apple system services go DIRECT.
# This configuration is intentionally optimized for
# faster Apple services access without proxy.

########################
# Apple core
########################
DOMAIN-SUFFIX,apple.com

########################
# App Store / iTunes CDN
########################
DOMAIN-SUFFIX,mzstatic.com
DOMAIN-SUFFIX,cdn-apple.com

########################
# iCloud
########################
DOMAIN-SUFFIX,icloud.com
DOMAIN-SUFFIX,icloud-content.com
DOMAIN-SUFFIX,me.com
DOMAIN-SUFFIX,apple-cloudkit.com

########################
# Apple DNS / infrastructure
########################
DOMAIN-SUFFIX,apple-dns.net
DOMAIN,doh.dns.apple.com
